{
  "name": "atrium",
  "version": "2.14.2",
  "description": "Copilot CLI extension that supersedes built-in tool primitives with faster, more powerful versions out of the box.",
  "type": "module",
  "bin": {
    "atrium": "./dist/cli.js",
    "atrium-mcp": "./dist/server.js"
  },
  "scripts": {
    "prebuild": "bun run lint:eslint && bun run lint:test",
    "build": "bun scripts/build.mjs",
    "build:native": "napi build --release --platform --js-package-name atrium-search --manifest-path crates/atrium-search/Cargo.toml --output-dir crates/atrium-search",
    "test": "node test/run.mjs \"test/**/*.test.ts\"",
    "test:unit": "node test/run.mjs \"test/unit/**/*.test.ts\"",
    "test:integration": "node test/run.mjs \"test/integration/**/*.test.ts\"",
    "lint": "bun run lint:eslint && bun run lint:src && bun run lint:test",
    "lint:eslint": "eslint src/ test/",
    "lint:src": "tsc --noEmit",
    "lint:test": "tsc --noEmit -p test/tsconfig.json",
    "benchmark": "bun scripts/benchmark-atrium.mjs",
    "clean": "bun -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "bun run build"
  },
  "keywords": [],
  "author": "Marcus Markiewicz",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@napi-rs/cli": "^3.8.6",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "minimatch": "^10.2.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}

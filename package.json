{
  "name": "atrium",
  "version": "2.9.0",
  "description": "Copilot CLI extension that supersedes built-in tool primitives with faster, more powerful versions out of the box.",
  "type": "module",
  "bin": {
    "atrium": "./dist/cli.js",
    "atrium-mcp": "./dist/server.js"
  },
  "scripts": {
    "prebuild": "eslint src/ test/ && tsc --noEmit -p test/tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:native": "napi build --release --platform --js-package-name atrium-search --manifest-path crates/atrium-search/Cargo.toml --output-dir crates/atrium-search",
    "test": "node test/run.mjs test/**/*.test.ts",
    "test:unit": "node test/run.mjs test/unit/**/*.test.ts",
    "test:integration": "node test/run.mjs test/integration/**/*.test.ts",
    "lint": "eslint src/ test/ && tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "benchmark": "node scripts/benchmark-atrium.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "Marcus Markiewicz",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@napi-rs/cli": "^3.7.2",
    "@types/node": "^22.15.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "minimatch": "^10.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
